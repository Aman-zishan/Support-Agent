# ── Pick ONE provider ────────────────────────────────────────────────────────
# Set exactly one key below and the project auto-detects it. No other config
# needed — every agent, tool and workflow is provider-agnostic.

# Groq — free tier, fastest. The workshop default.
#   https://console.groq.com
GROQ_API_KEY=your-api-key-here

# Anthropic
#   https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
#   https://platform.openai.com
# OPENAI_API_KEY=sk-...

# Google Gemini (routed through Mastra's built-in model router, no extra SDK)
#   https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=AQ....


# ── Optional overrides ───────────────────────────────────────────────────────
# Only needed if you have MORE THAN ONE key set above.
# MODEL_PROVIDER=groq          # groq | anthropic | openai | gemini

# Override the model. Defaults per provider:
#   groq       openai/gpt-oss-120b
#   anthropic  claude-opus-5      (cheaper: claude-haiku-4-5)
#   openai     gpt-4o
#   gemini     gemini-3.6-flash   (via Mastra router: google/<model>)
# MODEL_ID=
